      "viewport": [48, 36],
      "steps": 8,
      "from": {"box": [12.6, 9.4, 9.2, 6.7], "fill": [0.2, 0.4, 0.8, 1], "corner_radius": 2.1, "opacity": 1},
      "to": {"box": [12.6, 9.4, 24.8, 17.3], "fill": [0.2, 0.4, 0.8, 1], "corner_radius": 2.1, "opacity": 1}
    },
    {
